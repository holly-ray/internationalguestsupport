# ================================================
# WaiBin (国际宾客支持) — Environment Variables
# ================================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# ---- Required ----
# DeepSeek API key for AI translation
DEEPSEEK_API_KEY=sk-your-key-here

# ---- Strongly Recommended (Production) ----
# Fixed session secret (prevents all users being logged out on deploy)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ---- KV Storage (Upstash Redis) ----
# If not set, falls back to Flask session storage (volatile, per-instance)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ---- Auth ----
# Set to "true" to require phone login for translation API
REQUIRE_AUTH=false
# Demo mode uses hardcoded code "1234" — disable in production
VERIFICATION_MODE=demo

# ---- Rate Limiting ----
DAILY_TRANSLATION_LIMIT=20

# ---- PayJS WeChat Pay ----
PAYJS_MERCHANT_ID=
PAYJS_API_KEY=
# PayJS callback URL (must be publicly reachable)
PAYJS_CALLBACK_URL=https://your-domain.com/api/pay/callback

# ---- Google My Business OAuth ----
GMB_CLIENT_ID=
GMB_CLIENT_SECRET=
GMB_REDIRECT_URI=https://your-domain.com/gmb/callback

# ---- Admin ----
# Token for /api/admin/errors (omit to allow localhost only)
ADMIN_TOKEN=
